FROM python:3.11-slim

ARG POETRY_VERSION=2.1.3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CHROME_BIN=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Match the Poetry release used to generate the lock file.
RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

# Create app directory placeholder
# Code will be mounted as volume at runtime
RUN mkdir -p /app

RUN poetry config virtualenvs.create false

# Copy locked dependency metadata from the build context (code itself is mounted at runtime).
COPY webreport/data_collector/pyproject.toml webreport/data_collector/poetry.lock /tmp/

RUN cd /tmp && poetry install --only main --no-root --no-interaction --no-ansi

CMD ["python", "entrypoint.py"]
