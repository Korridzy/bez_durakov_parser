FROM python:3.11-slim@sha256:0dd364ba7e10242f07755449e3a3d0e35f9efd987952737b90def6709ab0c5ce

ARG POETRY_VERSION=2.1.3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/
ENV PYTHONUNBUFFERED=1
ENV CHROME_BIN=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Match the Poetry release used to generate the lock file.
RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

# Create app directory placeholder
# Code will be mounted as volume at runtime
RUN mkdir -p /app

RUN poetry config virtualenvs.create false

# Copy locked dependency metadata from the build context (code itself is mounted at runtime).
COPY webreport/data_collector/pyproject.toml webreport/data_collector/poetry.lock /tmp/

RUN cd /tmp && poetry install --only main --no-root --no-interaction --no-ansi

COPY bd_shared /bd_shared
COPY webreport/data_collector /app
COPY webreport/__init__.py /webreport/__init__.py
RUN ln -s /app /webreport/data_collector

ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/Korridzy/bez_durakov_parser" org.opencontainers.image.revision="${SOURCE_COMMIT}"

CMD ["python", "entrypoint.py"]
