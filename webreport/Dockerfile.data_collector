FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CHROME_BIN=/usr/bin/chromium
ENV POETRY_HOME="/opt/poetry"
ENV PATH="$POETRY_HOME/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tzdata \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -

WORKDIR /app

# Create app directory placeholder
# Code will be mounted as volume at runtime
RUN mkdir -p /app

RUN poetry config virtualenvs.create false

# Copy pyproject.toml from build context (code itself is mounted at runtime)
COPY webreport/data_collector/pyproject.toml /tmp/pyproject.toml

RUN cd /tmp && poetry install --only main --no-root --no-interaction --no-ansi

CMD ["python", "entrypoint.py"]
