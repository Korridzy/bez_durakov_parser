FROM python:3.11-slim@sha256:0dd364ba7e10242f07755449e3a3d0e35f9efd987952737b90def6709ab0c5ce

ARG POETRY_VERSION=2.1.3

ENV PYTHONPATH=/

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Match the Poetry release used to generate the lock file.
RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"

# Copy locked dependency metadata from the build context.
# We need to pre-install dependencies before mounting
COPY webreport/backend/pyproject.toml webreport/backend/poetry.lock /tmp/

# Configure poetry to not create virtual env (we're in container)
RUN poetry config virtualenvs.create false

# Install dependencies
RUN cd /tmp && poetry install --only main --no-root --no-interaction --no-ansi

# Application code, shared library and Alembic tooling. Development Compose
# bind mounts shadow /app and /bd_shared, so these copies serve release images.
COPY bd_shared /bd_shared
COPY alembic.ini /alembic/alembic.ini
COPY migrations /alembic/migrations
COPY webreport/backend /app

ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/Korridzy/bez_durakov_parser" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

# Expose port
EXPOSE 8000
EXPOSE 5678

# Run the backend
CMD ["python", "start.py"]
