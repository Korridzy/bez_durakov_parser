FROM node:22-alpine AS build
WORKDIR /ui
COPY webreport/ui/package.json webreport/ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY webreport/ui/index.html webreport/ui/tsconfig.json webreport/ui/vite.config.ts ./
COPY webreport/ui/src ./src
COPY webreport/ui/public ./public
RUN npm test && npm run build

FROM nginx:1.28-alpine
COPY webreport/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 8501
