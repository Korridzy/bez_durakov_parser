FROM node:22-alpine AS build
WORKDIR /ui
COPY webreport/frontend-web/package.json webreport/frontend-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY webreport/frontend-web/index.html webreport/frontend-web/tsconfig.json webreport/frontend-web/vite.config.ts ./
COPY webreport/frontend-web/src ./src
COPY webreport/frontend-web/public ./public
COPY webreport/frontend-web/scripts ./scripts
RUN npm run build

FROM nginx:1.28-alpine
COPY webreport/frontend-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 8501
