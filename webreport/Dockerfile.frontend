FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /ui
COPY webreport/ui/package.json webreport/ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY webreport/ui/index.html webreport/ui/tsconfig.json webreport/ui/vite.config.ts ./
COPY webreport/ui/src ./src
COPY webreport/ui/public ./public
RUN npm test && npm run build

FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/Korridzy/bez_durakov_parser" org.opencontainers.image.revision="${SOURCE_COMMIT}"

COPY webreport/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 8501
